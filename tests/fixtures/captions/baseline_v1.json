    {
      "id": "audio_event_does_not_change_returning_speaker",
      "mode": "source",
      "profile": "house-english-v1",
      "context": {"program_duration_secs": 5.4, "language": "eng"},
      "result": {
        "text": "Hi there (music) bye",
        "words": [
          {"text": "Hi", "start": 0.0, "end": 0.4, "type": "word", "speaker_id": "speaker_0"},
          {"text": "there", "start": 0.5, "end": 0.9, "type": "word", "speaker_id": "speaker_0"},
          {"text": "[music]", "start": 2.0, "end": 4.0, "type": "audio_event", "speaker_id": "speaker_1"},
          {"text": "bye", "start": 5.0, "end": 5.4, "type": "word", "speaker_id": "speaker_0"}
        ]
      },
      "expected_cues": [
        {"index": 1, "start": 0.0, "end": 0.9, "text": "Hi there", "speaker_id": "speaker_0", "is_audio_event": false},
        {"index": 2, "start": 2.0, "end": 4.0, "text": "(music)", "speaker_id": "speaker_1", "is_audio_event": true},
        {"index": 3, "start": 5.0, "end": 5.4, "text": "bye", "speaker_id": "speaker_0", "is_audio_event": false}
      ],
      "expected_exports": {"manual_dub_csv": {"bytes": 113, "sha256": "f8ab695a3916ea23bc17a50d3be0baa421043fb9e14f46f264c62e34bed921d7"}}
