      },
      "expected_cues": [
        {"index": 1, "start": 0.0, "end": 0.5, "text": "12345678901234567890123456789012345678901234567890", "speaker_id": "speaker_0", "is_audio_event": false},
        {"index": 2, "start": 0.6, "end": 0.7, "text": "reply", "speaker_id": "speaker_1", "is_audio_event": false}
