      "mode": "source",
      "profile": "house-english-v1",
      "context": {"program_duration_secs": 0.7, "language": "eng"},
      "result": {
        "text": "12345678901234567890123456789012345678901234567890 reply",
        "words": [
          {"text": "12345678901234567890123456789012345678901234567890", "start": 0.0, "end": 0.5, "type": "word", "speaker_id": "speaker_0"},
          {"text": "reply", "start": 0.6, "end": 0.7, "type": "word", "speaker_id": "speaker_1"}
